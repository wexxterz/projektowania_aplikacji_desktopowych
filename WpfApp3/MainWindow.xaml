<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="573">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Login" HorizontalAlignment="Center" VerticalAlignment="Center" Height="53" Width="82" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Segoe UI Black"/>
        <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="174" Height="42"/>
        <Button Grid.Row="2" Grid.Column="2" Content="LOGIN" HorizontalAlignment="Center" VerticalAlignment="Center" Height="45" Width="101" FontFamily="Bahnschrift SemiBold"/>
        <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="174" Height="42"/>
        <Label Content="Password" HorizontalAlignment="Center" VerticalAlignment="Top" Height="53" Width="82" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,47,0,0" Grid.Row="1" FontFamily="Segoe UI Black"/>
    </Grid>
</Window>
